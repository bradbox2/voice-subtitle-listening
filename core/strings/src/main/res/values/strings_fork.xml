<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings of the subtitle practice fork, kept out of strings.xml so syncing upstream doesn't
  conflict and upstream's locale coverage check only sees its own strings. Languages without a
  translation here fall back to English.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- Switches between the cover and the subtitles of the playing file. -->
    <string name="playback.subtitles.toggle">Subtitles</string>
    <!-- Opens the row with repeat, speed and subtitle sync on the subtitle screen. -->
    <string name="playback.subtitles.tools">Practice tools</string>
    <!-- Plays the current sentence again and again. -->
    <string name="playback.subtitles.repeat">Repeat sentence</string>
    <!-- Stars a subtitle line to practice it later. -->
    <string name="playback.subtitles.star">Star sentence</string>
    <!-- Removes the star of a subtitle line. -->
    <string name="playback.subtitles.unstar">Remove star</string>
    <!-- Moves all subtitles of the file earlier by a tenth of a second. -->
    <string name="playback.subtitles.sync_earlier">Show subtitles earlier</string>
    <!-- Moves all subtitles of the file later by a tenth of a second. -->
    <string name="playback.subtitles.sync_later">Show subtitles later</string>
    <!-- How far the subtitles are moved, like "Sync +0.3s". Tapping it resets the sync. -->
    <string name="playback.subtitles.sync">Sync %1$s</string>
    <!-- Playback mode: plays the files of the book one after the other. Shown on a small button, keep it short. -->
    <string name="playback.mode.sequential">Seq</string>
    <!-- Playback mode: repeats the current file. Shown on a small button, keep it short. -->
    <string name="playback.mode.single_track_loop">One</string>
    <!-- Playback mode: plays the files in random order. Shown on a small button, keep it short. -->
    <string name="playback.mode.shuffle">Shuf</string>
    <!-- Playback mode: repeats all files of the book. Shown on a small button, keep it short. -->
    <string name="playback.mode.folder_loop">All</string>
    <!-- Shown when a file of the book can't be found to play. %1$s is the file name. Keep the file name last, long names get cut off. -->
    <string name="playback.error.file_missing">File not found, it may have been moved or deleted: %1$s</string>
    <!-- Shown when a file of the book exists but can't be played. %1$s is the file name. -->
    <string name="playback.error.unplayable">Can\'t play %1$s.</string>
    <!-- Title of the screen with the study time per folder and file. Also the row in the settings that opens it. -->
    <string name="study.title">Study time</string>
    <!-- Label of the study time of today. -->
    <string name="study.today">Today</string>
    <!-- Label of the study time of all days. -->
    <string name="study.total">Total</string>
    <!-- Button that saves the study time as a CSV file for spreadsheets. -->
    <string name="study.export">Export as CSV</string>
    <!-- Shown after the study time was saved as a CSV file. -->
    <string name="study.exported">Exported</string>
    <!-- Shown on the study time screen before anything was played. -->
    <string name="study.empty">Nothing studied yet. Time counts while audio plays.</string>
    <!-- When a folder or file was last studied. %1$s is a date like 2026-11-04. -->
    <string name="study.last">last %1$s</string>
    <!-- A study time of an hour or more, like 1 h 23 min. -->
    <string name="study.time.hours_minutes">%1$d h %2$d min</string>
    <!-- A study time below an hour, like 23 min. -->
    <string name="study.time.minutes">%1$d min</string>
    <!-- How often a file was played to its end, like "3 plays". -->
    <plurals name="study.plays">
        <item quantity="one">%d play</item>
        <item quantity="other">%d plays</item>
    </plurals>
    <!-- Switch on the study time screen that lists the time per folder and file. -->
    <string name="study.view.folders">Folders</string>
    <!-- Switch on the study time screen that shows a calendar of a month. -->
    <string name="study.view.month">Month</string>
    <!-- Read out by screen readers for the button that shows the month before. -->
    <string name="study.month.previous">Previous month</string>
    <!-- Read out by screen readers for the button that shows the month after. -->
    <string name="study.month.next">Next month</string>
    <!-- Shown below the calendar for a day without study time. -->
    <string name="study.day.empty">Nothing studied on this day.</string>
    <!-- Minutes studied on a day, in a small calendar cell. Keep it as short as possible. -->
    <string name="study.time.minutes_short">%1$dm</string>
    <!-- Below the month of the calendar: the study time of the month and on how many days. %1$s is a time like "3 h 20 min", %2$d the number of days. -->
    <plurals name="study.month.summary">
        <item quantity="one">%1$s on %2$d day</item>
        <item quantity="other">%1$s on %2$d days</item>
    </plurals>
    <!-- A study time of less than a minute. -->
    <string name="study.time.less_than_minute">&lt; 1 min</string>
</resources>
